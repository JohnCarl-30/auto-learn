{
  "name": "auto-learn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @auto-learn/shared build && pnpm --parallel --filter \"@auto-learn/shared\" --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "eval": "pnpm --filter @auto-learn/shared build && pnpm --filter @auto-learn/evals eval",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "// node": "AbortSignal.any, which the streaming route composes its timeout and its client-disconnect signal with, landed in 20.3. The old >=20 admitted three releases where /propose/stream throws at runtime.",
    "node": ">=20.3"
  },
  "packageManager": "pnpm@10.33.0"
}
