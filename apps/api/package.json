{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "start:dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start:prod": "node --env-file-if-exists=.env dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest && vitest run",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:jest": "jest",
    "test:vitest": "vitest run",
    "lint:fix": "eslint \"src/**/*.ts\" --fix"
  },
  "dependencies": {
    "@ai-sdk/elevenlabs": "^3.0.29",
    "@ai-sdk/openai": "^4.0.42",
    "@anthropic-ai/sdk": "^1.12.0",
    "@auto-learn/shared": "workspace:*",
    "@hono/node-server": "^2.1.11",
    "ai": "^7.0.66",
    "hono": "^4.13.19",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.5.2",
    "wordpos": "^2.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.11"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
