# Required. The propose and card model calls both run through this key.
OPENAI_API_KEY=sk-...

# Voice: pronunciation for words the dictionary has no recording of, and (when
# set) dictation. Dictation falls back to OpenAI transcription without a key.
# Everything else — including the dictionary's own recordings and the written
# pronunciation on every card — works without these.
ELEVENLABS_API_KEY=sk_...

# A voice id, not a name. Take it from My Voices in the ElevenLabs dashboard:
# voices are account-scoped, and the shared Default voices are withdrawn at the
# end of 2026, so there is no id worth hardcoding here as a default.
ELEVENLABS_VOICE_ID=

PORT=3001
WEB_ORIGIN=http://localhost:3000

# Verifies the short-lived tokens the web app signs for a signed-in user. Must
# match API_JWT_SECRET in apps/web exactly. Without it, every route that asks
# who is calling answers 401: GET /me always, and the model routes too once
# REQUIRE_SIGN_IN (below) is on. With the lock off, the rest of the API works
# without it.
API_JWT_SECRET=

# Set to true on a public deploy so only signed-in callers can reach the routes
# that spend OPENAI_API_KEY (/converse, /propose, /card, /dictate, /speak). Those
# callers are checked with API_JWT_SECRET above, so set that too: with the lock
# on and no secret, every request is refused. Only the exact value true turns
# the lock on; unset or anything else (false, TRUE, 1) leaves every route open,
# which is what local development wants.
REQUIRE_SIGN_IN=
