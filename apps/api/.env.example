# Required. The propose and card model calls both run through this key.
OPENAI_API_KEY=sk-...

# Voice: dictation, and pronunciation for words the dictionary has no
# recording of. Everything else — including the dictionary's own recordings and
# the written pronunciation on every card — works without these.
ELEVENLABS_API_KEY=sk_...

# A voice id, not a name. Take it from My Voices in the ElevenLabs dashboard:
# voices are account-scoped, and the shared Default voices are withdrawn at the
# end of 2026, so there is no id worth hardcoding here as a default.
ELEVENLABS_VOICE_ID=

PORT=3001
WEB_ORIGIN=http://localhost:3000

# Verifies the short-lived tokens the web app signs for a signed-in user. Must
# match API_JWT_SECRET in apps/web exactly. Without it, every route that asks
# who is calling answers 401 — which today is only GET /me, so the rest of the
# API works without it.
API_JWT_SECRET=
