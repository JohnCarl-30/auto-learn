# Where the NestJS API is reachable from the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Sign-in ──────────────────────────────────────────────────────────────────
# Everything below is only needed for accounts. Fixing sentences, opening cards,
# banking words and hearing pronunciations all work with none of it set.

# Signs the session cookie. Any long random string; `openssl rand -base64 32`.
# Changing it signs everyone out.
AUTH_SECRET=

# Where the users, sessions and single-use sign-in links live.
# Locally:  createdb auto_learn
#           DATABASE_URL=postgres://localhost/auto_learn
# Then:     pnpm --filter web db:migrate
DATABASE_URL=

# Sends the sign-in emails. Leave it unset in development and the link is
# printed to the server console instead — which is enough to test the whole
# flow without a Resend account or a verified domain.
AUTH_RESEND_KEY=

# Must be an address at a domain verified in Resend. Resend's shared
# onboarding@resend.dev works for testing but only delivers to your own address.
AUTH_EMAIL_FROM="auto-learn <onboarding@resend.dev>"

# Shared with the API, which uses it to verify the short-lived tokens this app
# signs on a signed-in user's behalf. Must match API_JWT_SECRET there exactly.
API_JWT_SECRET=

# Only needed behind a proxy that terminates TLS — Render, Fly, a load balancer.
# Auth.js otherwise builds callback URLs from a host header it does not trust.
# AUTH_TRUST_HOST=true
